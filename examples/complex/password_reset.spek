# A flow whose whole meaning is sequence. Tests whether naming states
# -- the trick cache.get uses -- survives a real multi-step process.

request_reset(email) -> sent | unknown
  !db !net !rand
  : answer in the same time either way, or the endpoint enumerates users
  known ok
  unknown_email unknown
  ? the token is single-use and expires 15 minutes after this returns

validate_token(token) -> claim | expired | used | forged
  !db !hash
  fresh ok
  after_15min expired
  after_complete used
  tampered forged

complete_reset(token, new_password) -> reset | expired | used | weak
  !db !hash
  (fresh, strong) ok
  (after_15min, strong) expired
  (after_complete, strong) used
  (fresh, "abc") weak
  ? every existing session for the account is revoked
